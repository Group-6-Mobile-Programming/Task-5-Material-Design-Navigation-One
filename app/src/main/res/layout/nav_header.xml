<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/uc_black"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="40dp"
        android:paddingEnd="18dp"
        android:paddingBottom="18dp">

        <ImageView
            android:id="@+id/ivAppLogo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_icon_tile"
            android:backgroundTint="@color/uc_yellow"
            android:contentDescription="@string/app_name"
            android:padding="12dp"
            android:src="@drawable/ic_share"
            android:tint="@color/uc_black"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDrawerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/uc_white"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvDrawerSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_subtitle"
                android:textColor="@color/uc_header_subtitle"
                android:textSize="14sp"/>
        </LinearLayout>
    </LinearLayout>

    <include
        layout="@layout/view_flag_stripe"
        android:layout_width="match_parent"
        android:layout_height="6dp"/>
</LinearLayout>
